// Embedded unit tests, executed by `veryl test`.

#[test(test_alu)]
embed (inline) sv{{{
module test_alu;
    import rv32ima_RvPkg::*;

    AluOp        op;
    logic [31:0] a;
    logic [31:0] b;
    logic [31:0] y;

    rv32ima_Alu dut (
        .i_op (op),
        .i_a  (a),
        .i_b  (b),
        .o_y  (y)
    );

    task automatic check(input AluOp o, input logic [31:0] x, input logic [31:0] z, input logic [31:0] exp);
        op = o;
        a  = x;
        b  = z;
        #1;
        assert (y == exp)
            else $fatal(1, "op=%0d a=%h b=%h y=%h exp=%h", o, x, z, y, exp);
    endtask

    initial begin
        check(AluOp_op_add , 32'd5        , 32'd7        , 32'd12       );
        check(AluOp_op_add , 32'hffff_ffff, 32'd1        , 32'd0        );
        check(AluOp_op_sub , 32'd5        , 32'd7        , 32'hffff_fffe);
        check(AluOp_op_slt , 32'hffff_ffff, 32'd0        , 32'd1        );
        check(AluOp_op_slt , 32'd0        , 32'hffff_ffff, 32'd0        );
        check(AluOp_op_sltu, 32'hffff_ffff, 32'd0        , 32'd0        );
        check(AluOp_op_sltu, 32'd0        , 32'hffff_ffff, 32'd1        );
        check(AluOp_op_sll , 32'h1        , 32'd31       , 32'h8000_0000);
        check(AluOp_op_srl , 32'h8000_0000, 32'd31       , 32'h1        );
        check(AluOp_op_sra , 32'h8000_0000, 32'd31       , 32'hffff_ffff);
        check(AluOp_op_xor , 32'hff00_ff00, 32'h0ff0_0ff0, 32'hf0f0_f0f0);
        check(AluOp_op_or  , 32'hff00_ff00, 32'h0ff0_0ff0, 32'hfff0_fff0);
        check(AluOp_op_and , 32'hff00_ff00, 32'h0ff0_0ff0, 32'h0f00_0f00);
        $display("test_alu OK");
        $finish;
    end
endmodule
}}}

#[test(test_core_smoke)]
embed (inline) sv{{{
module test_core_smoke;
    logic        clk = 0;
    logic        rst = 1;
    logic        mem_valid;
    logic [31:0] mem_addr;
    logic [3:0]  mem_wstrb;
    logic [31:0] mem_wdata;
    logic [31:0] mem_rdata = 0;
    logic        mem_ready = 0;
    logic        retire;
    logic [31:0] retire_pc;
    logic [31:0] retire_instr;
    logic        trap;
    logic [31:0] trap_cause;

    rv32ima_Core dut (
        .i_clk          (clk),
        .i_rst          (rst),
        .o_mem_valid    (mem_valid),
        .o_mem_addr     (mem_addr),
        .o_mem_wstrb    (mem_wstrb),
        .o_mem_wdata    (mem_wdata),
        .i_mem_rdata    (mem_rdata),
        .i_mem_ready    (mem_ready),
        .i_irq_timer    (1'b0),
        .i_irq_soft     (1'b0),
        .i_irq_ext      (1'b0),
        .o_retire       (retire),
        .o_retire_pc    (retire_pc),
        .o_retire_instr (retire_instr),
        .o_trap         (trap),
        .o_trap_cause   (trap_cause)
    );

    // Program: x3 = 5 + 7; x5 = 5 * 7; store x3 then x5 to 0x8000_1000/4.
    logic [31:0] mem [0:2047];
    initial begin
        mem[0] = 32'h00500093; // addi x1, x0, 5
        mem[1] = 32'h00700113; // addi x2, x0, 7
        mem[2] = 32'h002081b3; // add  x3, x1, x2
        mem[3] = 32'h022082b3; // mul  x5, x1, x2
        mem[4] = 32'h80001237; // lui  x4, 0x80001
        mem[5] = 32'h00322023; // sw   x3, 0(x4)
        mem[6] = 32'h00522223; // sw   x5, 4(x4)
        mem[7] = 32'h0000006f; // jal  x0, 0 (spin)
    end

    always #5 clk = ~clk;

    wire [31:0] widx = (mem_addr - 32'h8000_0000) >> 2;
    logic [31:0] got_sum  = 0;
    logic [31:0] got_prod = 0;

    always @(posedge clk) begin
        if (mem_ready) begin
            mem_ready <= 0;
        end else if (mem_valid) begin
            if (mem_wstrb != 0) begin
                for (int b = 0; b < 4; b++) begin
                    if (mem_wstrb[b]) mem[widx][8*b +: 8] <= mem_wdata[8*b +: 8];
                end
                if (mem_addr == 32'h8000_1000) got_sum  <= mem_wdata;
                if (mem_addr == 32'h8000_1004) got_prod <= mem_wdata;
            end else if (mem_addr == 32'h0000_1000) begin
                mem_rdata <= 32'h800002b7; // boot stub: lui t0, 0x80000
            end else if (mem_addr == 32'h0000_1004) begin
                mem_rdata <= 32'h00028067; // boot stub: jalr x0, 0(t0)
            end else begin
                mem_rdata <= mem[widx];
            end
            mem_ready <= 1;
        end
    end

    always @(posedge clk) begin
        if (trap) $fatal(1, "unexpected trap cause=%0d", trap_cause);
        if (got_sum != 0 && got_prod != 0) begin
            assert (got_sum == 32'd12) else $fatal(1, "sum=%0d", got_sum);
            assert (got_prod == 32'd35) else $fatal(1, "prod=%0d", got_prod);
            $display("test_core_smoke OK");
            $finish;
        end
    end

    initial begin
        repeat (4) @(posedge clk);
        rst = 0;
        repeat (2000) @(posedge clk);
        $fatal(1, "timeout");
    end
endmodule
}}}

#[test(test_clint)]
embed (inline) sv{{{
module test_clint;
    logic        clk = 0;
    logic        rst = 1;
    logic        sel = 0;
    logic [15:0] addr = 0;
    logic [3:0]  wstrb = 0;
    logic [31:0] wdata = 0;
    logic [31:0] rdata;
    logic        tick = 0;
    logic        irq_timer;
    logic        irq_soft;

    rv32ima_Clint dut (
        .i_clk       (clk),
        .i_rst       (rst),
        .i_sel       (sel),
        .i_addr      (addr),
        .i_wstrb     (wstrb),
        .i_wdata     (wdata),
        .o_rdata     (rdata),
        .i_tick      (tick),
        .o_irq_timer (irq_timer),
        .o_irq_soft  (irq_soft)
    );

    always #5 clk = ~clk;

    // One bus access: sel for a single cycle, as the SoC drives it.
    task automatic bus_write(input logic [15:0] a, input logic [31:0] d);
        @(negedge clk);
        sel = 1; addr = a; wstrb = 4'hf; wdata = d;
        @(posedge clk);
        @(negedge clk);
        sel = 0; wstrb = 4'h0;
    endtask

    task automatic bus_read(input logic [15:0] a, output logic [31:0] d);
        @(negedge clk);
        sel = 1; addr = a; wstrb = 4'h0;
        #1 d = rdata;
        @(posedge clk);
        @(negedge clk);
        sel = 0;
    endtask

    logic [31:0] v;

    initial begin
        repeat (2) @(posedge clk);
        @(negedge clk);
        rst = 0;

        // mtimecmp resets to all-ones, so no timer interrupt is pending.
        assert (irq_timer == 1'b0) else $fatal(1, "spurious timer irq");
        assert (irq_soft == 1'b0) else $fatal(1, "spurious soft irq");

        // msip is one bit wide and drives the software interrupt.
        bus_write(16'h0000, 32'hffff_ffff);
        bus_read(16'h0000, v);
        assert (v == 32'h1) else $fatal(1, "msip=%h", v);
        assert (irq_soft == 1'b1) else $fatal(1, "soft irq not raised");
        bus_write(16'h0000, 32'h0);
        assert (irq_soft == 1'b0) else $fatal(1, "soft irq not cleared");

        // mtime only advances on a tick.
        bus_read(16'hbff8, v);
        assert (v == 32'h0) else $fatal(1, "mtime moved without a tick: %h", v);
        tick = 1;
        repeat (10) @(posedge clk);
        @(negedge clk);
        tick = 0;
        bus_read(16'hbff8, v);
        assert (v == 32'd10) else $fatal(1, "mtime=%0d, expected 10", v);

        // mtime is read-only.
        bus_write(16'hbff8, 32'h0);
        bus_read(16'hbff8, v);
        assert (v == 32'd10) else $fatal(1, "mtime was writable: %0d", v);

        // The timer fires once mtime reaches mtimecmp.
        bus_write(16'h4004, 32'h0);
        bus_write(16'h4000, 32'd12);
        bus_read(16'h4000, v);
        assert (v == 32'd12) else $fatal(1, "mtimecmp=%0d", v);
        assert (irq_timer == 1'b0) else $fatal(1, "timer irq too early");
        tick = 1;
        repeat (2) @(posedge clk);
        @(negedge clk);
        tick = 0;
        assert (irq_timer == 1'b1) else $fatal(1, "timer irq did not fire");

        $display("test_clint OK");
        $finish;
    end

    initial begin
        repeat (2000) @(posedge clk);
        $fatal(1, "timeout");
    end
endmodule
}}}

#[test(test_plic)]
embed (inline) sv{{{
module test_plic;
    logic        clk = 0;
    logic        rst = 1;
    logic        sel = 0;
    logic [21:0] addr = 0;
    logic [3:0]  wstrb = 0;
    logic [31:0] wdata = 0;
    logic [31:0] rdata;
    logic        src = 0;
    logic        irq;

    rv32ima_Plic dut (
        .i_clk   (clk),
        .i_rst   (rst),
        .i_sel   (sel),
        .i_addr  (addr),
        .i_wstrb (wstrb),
        .i_wdata (wdata),
        .o_rdata (rdata),
        .i_src   (src),
        .o_irq   (irq)
    );

    always #5 clk = ~clk;

    task automatic bus_write(input logic [21:0] a, input logic [31:0] d);
        @(negedge clk);
        sel = 1; addr = a; wstrb = 4'hf; wdata = d;
        @(posedge clk);
        @(negedge clk);
        sel = 0; wstrb = 4'h0;
    endtask

    task automatic bus_read(input logic [21:0] a, output logic [31:0] d);
        @(negedge clk);
        sel = 1; addr = a; wstrb = 4'h0;
        #1 d = rdata;
        @(posedge clk);
        @(negedge clk);
        sel = 0;
    endtask

    logic [31:0] v;

    initial begin
        repeat (2) @(posedge clk);
        @(negedge clk);
        rst = 0;

        // An asserted line alone does not interrupt: it must be enabled and
        // above the threshold.
        src = 1;
        assert (irq == 1'b0) else $fatal(1, "irq without enable");
        bus_read(22'h001000, v);
        assert (v == 32'h2) else $fatal(1, "pending=%h", v);

        bus_write(22'h002000, 32'hffff_ffff);
        bus_read(22'h002000, v);
        assert (v == 32'h2) else $fatal(1, "enable=%h, only source 1 exists", v);
        assert (irq == 1'b0) else $fatal(1, "irq at priority 0");

        // Priority and threshold are three bits wide.
        bus_write(22'h000004, 32'hffff_ffff);
        bus_read(22'h000004, v);
        assert (v == 32'h7) else $fatal(1, "priority=%h", v);
        bus_write(22'h200000, 32'hffff_ffff);
        bus_read(22'h200000, v);
        assert (v == 32'h7) else $fatal(1, "threshold=%h", v);

        // The threshold is exclusive: priority 7 does not pass a threshold 7.
        assert (irq == 1'b0) else $fatal(1, "irq at priority == threshold");
        bus_read(22'h200004, v);
        assert (v == 32'h0) else $fatal(1, "claimed %0d below threshold", v);

        bus_write(22'h200000, 32'h0);
        assert (irq == 1'b1) else $fatal(1, "irq not raised");

        // The claim hands the source to the handler; the gateway then holds it
        // back until the completion.
        bus_read(22'h200004, v);
        assert (v == 32'h1) else $fatal(1, "claim=%0d", v);
        assert (irq == 1'b0) else $fatal(1, "irq still asserted after claim");
        bus_read(22'h001000, v);
        assert (v == 32'h0) else $fatal(1, "pending=%h while claimed", v);
        bus_read(22'h200004, v);
        assert (v == 32'h0) else $fatal(1, "claimed twice");

        // A completion naming a source this context has not enabled is ignored.
        bus_write(22'h200004, 32'd5);
        assert (irq == 1'b0) else $fatal(1, "bogus completion released the claim");

        bus_write(22'h200004, 32'd1);
        assert (irq == 1'b1) else $fatal(1, "completion did not re-arm the source");

        // Dropping the device line drops the interrupt.
        src = 0;
        #1;
        assert (irq == 1'b0) else $fatal(1, "irq without a source line");

        $display("test_plic OK");
        $finish;
    end

    initial begin
        repeat (2000) @(posedge clk);
        $fatal(1, "timeout");
    end
endmodule
}}}
