// Embedded unit tests, executed by `veryl test`.

#[test(test_alu)]
embed (inline) sv{{{
module test_alu;
    import rv32ima_RvPkg::*;

    AluOp        op;
    logic [31:0] a;
    logic [31:0] b;
    logic [31:0] y;

    rv32ima_Alu dut (
        .i_op (op),
        .i_a  (a),
        .i_b  (b),
        .o_y  (y)
    );

    task automatic check(input AluOp o, input logic [31:0] x, input logic [31:0] z, input logic [31:0] exp);
        op = o;
        a  = x;
        b  = z;
        #1;
        assert (y == exp)
            else $fatal(1, "op=%0d a=%h b=%h y=%h exp=%h", o, x, z, y, exp);
    endtask

    initial begin
        check(AluOp_op_add , 32'd5        , 32'd7        , 32'd12       );
        check(AluOp_op_add , 32'hffff_ffff, 32'd1        , 32'd0        );
        check(AluOp_op_sub , 32'd5        , 32'd7        , 32'hffff_fffe);
        check(AluOp_op_slt , 32'hffff_ffff, 32'd0        , 32'd1        );
        check(AluOp_op_slt , 32'd0        , 32'hffff_ffff, 32'd0        );
        check(AluOp_op_sltu, 32'hffff_ffff, 32'd0        , 32'd0        );
        check(AluOp_op_sltu, 32'd0        , 32'hffff_ffff, 32'd1        );
        check(AluOp_op_sll , 32'h1        , 32'd31       , 32'h8000_0000);
        check(AluOp_op_srl , 32'h8000_0000, 32'd31       , 32'h1        );
        check(AluOp_op_sra , 32'h8000_0000, 32'd31       , 32'hffff_ffff);
        check(AluOp_op_xor , 32'hff00_ff00, 32'h0ff0_0ff0, 32'hf0f0_f0f0);
        check(AluOp_op_or  , 32'hff00_ff00, 32'h0ff0_0ff0, 32'hfff0_fff0);
        check(AluOp_op_and , 32'hff00_ff00, 32'h0ff0_0ff0, 32'h0f00_0f00);
        $display("test_alu OK");
        $finish;
    end
endmodule
}}}

#[test(test_core_smoke)]
embed (inline) sv{{{
module test_core_smoke;
    logic        clk = 0;
    logic        rst = 1;
    logic        mem_valid;
    logic [31:0] mem_addr;
    logic [3:0]  mem_wstrb;
    logic [31:0] mem_wdata;
    logic [31:0] mem_rdata = 0;
    logic        mem_ready = 0;
    logic        retire;
    logic [31:0] retire_pc;
    logic [31:0] retire_instr;
    logic        trap;
    logic [31:0] trap_cause;

    rv32ima_Core dut (
        .i_clk          (clk),
        .i_rst          (rst),
        .o_mem_valid    (mem_valid),
        .o_mem_addr     (mem_addr),
        .o_mem_wstrb    (mem_wstrb),
        .o_mem_wdata    (mem_wdata),
        .i_mem_rdata    (mem_rdata),
        .i_mem_ready    (mem_ready),
        .i_irq_timer    (1'b0),
        .i_irq_soft     (1'b0),
        .o_retire       (retire),
        .o_retire_pc    (retire_pc),
        .o_retire_instr (retire_instr),
        .o_trap         (trap),
        .o_trap_cause   (trap_cause)
    );

    // Program: x3 = 5 + 7; x5 = 5 * 7; store x3 then x5 to 0x8000_1000/4.
    logic [31:0] mem [0:2047];
    initial begin
        mem[0] = 32'h00500093; // addi x1, x0, 5
        mem[1] = 32'h00700113; // addi x2, x0, 7
        mem[2] = 32'h002081b3; // add  x3, x1, x2
        mem[3] = 32'h022082b3; // mul  x5, x1, x2
        mem[4] = 32'h80001237; // lui  x4, 0x80001
        mem[5] = 32'h00322023; // sw   x3, 0(x4)
        mem[6] = 32'h00522223; // sw   x5, 4(x4)
        mem[7] = 32'h0000006f; // jal  x0, 0 (spin)
    end

    always #5 clk = ~clk;

    wire [31:0] widx = (mem_addr - 32'h8000_0000) >> 2;
    logic [31:0] got_sum  = 0;
    logic [31:0] got_prod = 0;

    always @(posedge clk) begin
        if (mem_ready) begin
            mem_ready <= 0;
        end else if (mem_valid) begin
            if (mem_wstrb != 0) begin
                for (int b = 0; b < 4; b++) begin
                    if (mem_wstrb[b]) mem[widx][8*b +: 8] <= mem_wdata[8*b +: 8];
                end
                if (mem_addr == 32'h8000_1000) got_sum  <= mem_wdata;
                if (mem_addr == 32'h8000_1004) got_prod <= mem_wdata;
            end else if (mem_addr == 32'h0000_1000) begin
                mem_rdata <= 32'h800002b7; // boot stub: lui t0, 0x80000
            end else if (mem_addr == 32'h0000_1004) begin
                mem_rdata <= 32'h00028067; // boot stub: jalr x0, 0(t0)
            end else begin
                mem_rdata <= mem[widx];
            end
            mem_ready <= 1;
        end
    end

    always @(posedge clk) begin
        if (trap) $fatal(1, "unexpected trap cause=%0d", trap_cause);
        if (got_sum != 0 && got_prod != 0) begin
            assert (got_sum == 32'd12) else $fatal(1, "sum=%0d", got_sum);
            assert (got_prod == 32'd35) else $fatal(1, "prod=%0d", got_prod);
            $display("test_core_smoke OK");
            $finish;
        end
    end

    initial begin
        repeat (4) @(posedge clk);
        rst = 0;
        repeat (2000) @(posedge clk);
        $fatal(1, "timeout");
    end
endmodule
}}}
