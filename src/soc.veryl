/// Core plus its interrupt controllers.
///
/// The CLINT and the PLIC sit behind the core's single memory port: accesses in
/// their address windows are answered here and never reach o_mem_*, everything
/// else (ROM, RAM, UART, SYSCON) is forwarded to the platform unchanged.
///
/// | window                      | device |
/// |-----------------------------|--------|
/// | `0x0c00_0000 .. 0x0c3f_ffff`| PLIC   |
/// | `0x1100_0000 .. 0x1100_ffff`| CLINT  |
///
/// Both devices answer combinationally in the cycle the core presents the
/// request, matching the core's protocol (valid held until ready).
module Soc #(
    param SRC_COUNT: u32 = 1, // PLIC sources, numbered 1..SRC_COUNT
) (
    i_clk: input clock,
    i_rst: input reset,

    o_mem_valid: output logic    ,
    o_mem_addr : output logic<32>,
    o_mem_wstrb: output logic<4> ,
    o_mem_wdata: output logic<32>,
    i_mem_rdata: input  logic<32>,
    i_mem_ready: input  logic    ,

    /// One-cycle pulse per mtime increment (the platform's real-time reference).
    i_mtime_tick: input logic,
    /// Level-triggered PLIC source lines; bit i is source i+1.
    i_irq_src: input logic<SRC_COUNT>,

    o_retire      : output logic    ,
    o_retire_pc   : output logic<32>,
    o_retire_instr: output logic<32>,
    o_trap        : output logic    ,
    o_trap_cause  : output logic<32>,
) {

    const PLIC_BASE : logic<32> = 32'h0c00_0000;
    const PLIC_MASK : logic<32> = 32'hffc0_0000; // 4 MiB
    const CLINT_BASE: logic<32> = 32'h1100_0000;
    const CLINT_MASK: logic<32> = 32'hffff_0000; // 64 KiB

    var c_mem_valid: logic    ;
    var c_mem_addr : logic<32>;
    var c_mem_wstrb: logic<4> ;
    var c_mem_wdata: logic<32>;
    var c_mem_rdata: logic<32>;
    var c_mem_ready: logic    ;

    let plic_hit : logic = (c_mem_addr & PLIC_MASK) == PLIC_BASE;
    let clint_hit: logic = (c_mem_addr & CLINT_MASK) == CLINT_BASE;

    let plic_sel : logic = c_mem_valid && plic_hit;
    let clint_sel: logic = c_mem_valid && clint_hit;
    let local_sel: logic = plic_sel || clint_sel;

    var clint_rdata: logic<32>;
    var plic_rdata : logic<32>;

    var irq_timer: logic;
    var irq_soft : logic;
    var irq_ext  : logic;

    // Requests for a local device are answered here and never leave the SoC.
    assign o_mem_valid = c_mem_valid && !local_sel;
    assign o_mem_addr  = c_mem_addr;
    assign o_mem_wstrb = c_mem_wstrb;
    assign o_mem_wdata = c_mem_wdata;

    always_comb {
        if clint_sel {
            c_mem_ready = 1'b1;
            c_mem_rdata = clint_rdata;
        } else if plic_sel {
            c_mem_ready = 1'b1;
            c_mem_rdata = plic_rdata;
        } else {
            c_mem_ready = i_mem_ready;
            c_mem_rdata = i_mem_rdata;
        }
    }

    inst u_core: Core (
        i_clk: i_clk,
        i_rst: i_rst,

        o_mem_valid: c_mem_valid,
        o_mem_addr : c_mem_addr ,
        o_mem_wstrb: c_mem_wstrb,
        o_mem_wdata: c_mem_wdata,
        i_mem_rdata: c_mem_rdata,
        i_mem_ready: c_mem_ready,

        i_irq_timer: irq_timer,
        i_irq_soft : irq_soft ,
        i_irq_ext  : irq_ext  ,

        o_retire      : o_retire      ,
        o_retire_pc   : o_retire_pc   ,
        o_retire_instr: o_retire_instr,
        o_trap        : o_trap        ,
        o_trap_cause  : o_trap_cause  ,
    );

    inst u_clint: Clint (
        i_clk: i_clk,
        i_rst: i_rst,

        i_sel  : clint_sel       ,
        i_addr : c_mem_addr[15:0],
        i_wstrb: c_mem_wstrb     ,
        i_wdata: c_mem_wdata     ,
        o_rdata: clint_rdata     ,

        i_tick: i_mtime_tick,

        o_irq_timer: irq_timer,
        o_irq_soft : irq_soft ,
    );

    inst u_plic: Plic #(
        SRC_COUNT: SRC_COUNT,
    ) (
        i_clk: i_clk,
        i_rst: i_rst,

        i_sel  : plic_sel        ,
        i_addr : c_mem_addr[21:0],
        i_wstrb: c_mem_wstrb     ,
        i_wdata: c_mem_wdata     ,
        o_rdata: plic_rdata      ,

        i_src: i_irq_src,

        o_irq: irq_ext,
    );
}
