/// Holds reset asserted for the first 2**CYCLES_LOG2 clocks after
/// configuration.
///
/// The boards use this instead of a reset button: on the Tang Primer the
/// buttons are on the dock, and depending on one would tie the port to a
/// particular dock.
///
/// A reset really is needed rather than just relying on power-up state, since
/// the core has to start with pc at the reset vector rather than zero.
///
/// Configuration initial values are explicit: synthesis can map `done` to
/// a Gowin DFFS, whose default INIT is one. Without an explicit zero, that
/// mapping skips the reset pulse and prevents the SoC from booting.
///
/// o_rst is plain logic; the board top casts it to the reset type.
module PowerOnReset #(
    param CYCLES_LOG2: u32 = 8,
) (
    i_clk: input  clock,
    o_rst: output logic,
) {

    #[sv("init = 0")]
    var count: logic<CYCLES_LOG2>;
    #[sv("init = 0")]
    var done: logic;

    always_ff (i_clk) {
        if !done {
            count = count + 1;
            if count == '1 {
                done = 1'b1;
            }
        }
    }

    assign o_rst = ~done;
}
