/// Digilent Arty A7-35 (Xilinx Artix-7 XC7A35TICSG324-1L).
///
/// The board's 100 MHz oscillator is well above what this core closes timing
/// at - the M extension's single-cycle divide is the critical path - so the SoC
/// runs from a divided clock. A quarter of 100 MHz is a deliberately
/// conservative starting point: place-and-route for this part needs openXC7,
/// which the repository's verified toolchain does not carry, so the achievable
/// frequency has not been measured here. Lower CLK_DIV_LOG2 to 1 for 50 MHz if
/// a build reports positive slack.
///
/// A counter output is used directly as the SoC clock. The open flow routes it
/// as an ordinary clock net, which is fine at these rates; a Vivado user would
/// normally substitute an MMCM here instead.
///
/// Build with `make fpga-arty`, program with `make fpga-arty-prog`.
module ArtyA7 (
    i_clk: input 'pin clock, // E3, 100 MHz

    i_uart_rx: input  'cpu logic, // A9,  host -> FPGA (uart_txd_in)
    o_uart_tx: output 'cpu logic, // D10, FPGA -> host (uart_rxd_out)

    o_led: output 'cpu logic<4>, // H5, J5, T9, T10
) {

    const CLK_DIV_LOG2: u32 = 2;
    const CLK_HZ      : u32 = 100_000_000 / (1 << CLK_DIV_LOG2);

    /// 25 MHz / (16 * 27) = 57870 baud, 0.5% off 57600. 115200 is only
    /// reachable within 3% from 50 MHz, so it goes with CLK_DIV_LOG2 = 1.
    const UART_DIV: u32 = 27;

    var div: 'pin logic<CLK_DIV_LOG2>;

    always_ff (i_clk) {
        div = div + 1;
    }

    var soc_clk: 'cpu clock;

    // Deriving one clock from another is a crossing by construction. It is
    // safe here because everything downstream, reset included, lives wholly in
    // the divided domain.
    unsafe (cdc) {
        assign soc_clk = div[CLK_DIV_LOG2 - 1];
    }

    var por_rst: 'cpu logic;

    inst u_por: PowerOnReset (
        i_clk: soc_clk,
        o_rst: por_rst,
    );

    let rst: 'cpu reset = por_rst as reset;

    var retire: 'cpu logic;

    inst u_soc: FpgaSoc #(
        CLK_HZ   : CLK_HZ                 ,
        RAM_WORDS: 16384                  , // 64 KiB
        RAM_INIT : "sim/fpga/firmware.hex",
        UART_DIV : UART_DIV               ,
    ) (
        i_clk: soc_clk,
        i_rst: rst    ,

        i_uart_rx: i_uart_rx,
        o_uart_tx: o_uart_tx,

        o_ext_sel  : _    ,
        o_ext_addr : _    ,
        o_ext_wstrb: _    ,
        o_ext_wdata: _    ,
        i_ext_rdata: 32'h0,

        o_retire: retire,
    );

    // LED0 is a ~1 Hz heartbeat, LED1 stretches instruction retirement into
    // something an eye can see, LED2 follows the transmit line and LED3 shows
    // the core is out of reset. Between them a dark board says which stage
    // failed.
    var heartbeat: 'cpu logic<25>;
    var act      : 'cpu logic<21>;

    always_ff (soc_clk) {
        heartbeat = heartbeat + 1;
        if retire {
            act = '1;
        } else if act != '0 {
            act = act - 1;
        }
    }

    assign o_led = {~por_rst, o_uart_tx, act != '0, heartbeat[24]};
}
