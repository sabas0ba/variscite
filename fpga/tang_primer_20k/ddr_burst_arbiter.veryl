/// Two clients sharing one DDR burst controller, all in the memory domain.
/// Client 0 is CPU, client 1 is display. Each has a separate response slot:
/// a stalled CPU response must not prevent display reads or DDR refresh.
/// Display wins when urgent, otherwise simultaneous requests alternate.
/// Reset must be common with both clients and the downstream controller.
module DdrBurstArbiter (
    i_clk           : input  clock         ,
    i_rst           : input  reset         ,
    i_req_valid     : input  logic<2>      ,
    o_req_ready     : output logic<2>      ,
    i_req_addr      : input  logic<27>  [2],
    i_req_data      : input  logic<128> [2],
    i_req_strb      : input  logic<16>  [2],
    o_rsp_valid     : output logic<2>      ,
    i_rsp_ready     : input  logic<2>      ,
    o_rsp_data      : output logic<128> [2],
    o_rsp_error     : output logic<2>      ,
    i_display_urgent: input  logic         ,
    o_mem_valid     : output logic         ,
    i_mem_ready     : input  logic         ,
    o_mem_addr      : output logic<27>     ,
    o_mem_data      : output logic<128>    ,
    o_mem_strb      : output logic<16>     ,
    i_mem_rsp_valid : input  logic         ,
    o_mem_rsp_ready : output logic         ,
    i_mem_rsp_data  : input  logic<128>    ,
    i_mem_rsp_error : input  logic         ,
) {
    enum State: logic<2> {
        idle,
        issue,
        response,
    }
    var state         : State;
    var owner         : logic;
    var prefer_display: logic;
    // An urgent reader needs one cycle to consume its previous response and
    // present the next request. Do not fill that cycle with a CPU transaction.
    // Urgency must be deasserted when the display no longer needs service.
    let reserve_display: logic    = i_display_urgent && o_rsp_valid[1];
    let eligible       : logic<2> = i_req_valid & ~o_rsp_valid & {1'b1, !reserve_display};
    let choose_display : logic    = eligible[1] && (!eligible[0] || i_display_urgent || prefer_display);
    assign o_req_ready     = if state == State::idle && eligible != 0 ? (if choose_display ? 2'b10 : 2'b01) : 2'b00;
    assign o_mem_valid     = state == State::issue;
    assign o_mem_rsp_ready = state == State::response;

    always_ff {
        if_reset {
            state          = State::idle;
            owner          = 0;
            prefer_display = 0;
            o_mem_addr     = 0;
            o_mem_data     = 0;
            o_mem_strb     = 0;
            o_rsp_valid    = 0;
            o_rsp_error    = 0;
            o_rsp_data     = '{default: 0};
        } else {
            for client in 0..2 {
                if o_rsp_valid[client] && i_rsp_ready[client] {
                    o_rsp_valid[client] = 0;
                }
            }
            case state {
                State::idle: {
                    if eligible != 0 {
                        owner          = choose_display;
                        prefer_display = !choose_display;
                        o_mem_addr     = i_req_addr[choose_display];
                        o_mem_data     = i_req_data[choose_display];
                        o_mem_strb     = i_req_strb[choose_display];
                        state          = State::issue;
                    }
                }
                State::issue: {
                    if i_mem_ready {
                        state = State::response;
                    }
                }
                State::response: {
                    if i_mem_rsp_valid {
                        o_rsp_data[owner]  = i_mem_rsp_data;
                        o_rsp_error[owner] = i_mem_rsp_error;
                        o_rsp_valid[owner] = 1;
                        state              = State::idle;
                    }
                }
                default: state = State::idle;
            }
        }
    }
}
