/// The Tang Primer 20K's parameterisation of FpgaSoc.
///
/// The board top is SystemVerilog, because it has to instantiate the Gowin PLL
/// primitive, and yosys's slang frontend elaborates the Veryl output before
/// that top is read - so the parameters cannot be passed in from there. Fixing
/// them here keeps them in Veryl, where they are checked, and leaves the
/// SystemVerilog top with nothing but pins, the PLL and reset.
module TangSoc (
    i_clk: input clock,
    i_rst: input reset,

    i_uart_rx: input  logic,
    o_uart_tx: output logic,
) {

    inst u_soc: FpgaSoc #(
        CLK_HZ   : 15_000_000             , // PLL output; see pll.sv
        RAM_WORDS: 8192                   , // 32 KiB
        RAM_INIT : "sim/fpga/firmware.hex",
        UART_DIV : 8                      , // 15 MHz / (16 * 8) = 117188 baud
    ) (
        i_clk: i_clk,
        i_rst: i_rst,

        i_uart_rx: i_uart_rx,
        o_uart_tx: o_uart_tx,

        o_retire: _,
    );
}
