/// One outstanding CPU word request crossing to a 128-bit DDR burst port.
/// Payload mailboxes stay stable until acknowledged; only toggles are synced.
/// Both domains require the SAME asynchronous reset (e.g. POR or PLL loss).
/// Backend response must occur after or on request acceptance, exactly once.
module DdrWordCdc (
    i_cpu_clk  : input  'cpu   clock                ,
    i_mem_clk  : input  'mem   clock                ,
    i_reset    : input  'async reset_async_high     ,
    i_valid    : input  'cpu   logic                ,
    i_addr     : input  'cpu   logic           <32> ,
    i_wdata    : input  'cpu   logic           <32> ,
    i_wstrb    : input  'cpu   logic           <4>  ,
    o_ready    : output 'cpu   logic                ,
    o_rdata    : output 'cpu   logic           <32> ,
    o_req_valid: output 'mem   logic                ,
    i_req_ready: input  'mem   logic                ,
    o_req_addr : output 'mem   logic           <32> ,
    o_req_wdata: output 'mem   logic           <128>,
    o_req_wstrb: output 'mem   logic           <16> ,
    i_rsp_valid: input  'mem   logic                ,
    i_rsp_data : input  'mem   logic           <128>,
) {
    enum CpuState: logic<2> {
        idle,
        waiting,
        response,
    }
    enum MemState: logic<2> {
        idle,
        request,
        waiting,
    }
    var cpu_state       : 'cpu CpuState     ;
    var mem_state       : 'mem MemState     ;
    var request_toggle  : 'cpu logic        ;
    var response_toggle : 'mem logic        ;
    var address_mailbox : 'cpu logic   <32> ;
    var write_mailbox   : 'cpu logic   <32> ;
    var strobe_mailbox  : 'cpu logic   <4>  ;
    var response_mailbox: 'mem logic   <128>;
    #[sv("async_reg = \"true\"")]
    var request_sync: 'mem logic<2>;
    #[sv("async_reg = \"true\"")]
    var response_sync: 'cpu logic<2> ;
    var mem_address  : 'mem logic<32>;
    var mem_write    : 'mem logic<32>;
    var mem_strobe   : 'mem logic<4> ;

    #[sv("async_reg = \"true\"")]
    var cpu_release: 'cpu logic<2>;
    #[sv("async_reg = \"true\"")]
    var mem_release: 'mem logic           <2>;
    var cpu_reset  : 'cpu reset_async_high   ;
    var mem_reset  : 'mem reset_async_high   ;
    assign cpu_reset = (!cpu_release[1]) as reset_async_high;
    assign mem_reset = (!mem_release[1]) as reset_async_high;

    unsafe (cdc) {
        always_ff (i_cpu_clk, i_reset) {
            if_reset {
                cpu_release = 0;
            } else {
                cpu_release = {cpu_release[0], 1'b1};
            }
        }
        always_ff (i_mem_clk, i_reset) {
            if_reset {
                mem_release = 0;
            } else {
                mem_release = {mem_release[0], 1'b1};
            }
        }
        always_ff (i_cpu_clk, cpu_reset) {
            if_reset {
                cpu_state       = CpuState::idle;
                request_toggle  = 0;
                response_sync   = 0;
                address_mailbox = 0;
                write_mailbox   = 0;
                strobe_mailbox  = 0;
                o_rdata         = 0;
            } else {
                response_sync = {response_sync[0], response_toggle};
                case cpu_state {
                    CpuState::idle    : if i_valid {
                        address_mailbox = i_addr;
                        write_mailbox   = i_wdata;
                        strobe_mailbox  = i_wstrb;
                        request_toggle  = !request_toggle;
                        cpu_state       = CpuState::waiting;
                    }
                    CpuState::waiting : if response_sync[1] == request_toggle {
                        o_rdata   = response_mailbox[32 * address_mailbox[3:2]+:32];
                        cpu_state = CpuState::response;
                    }
                    CpuState::response: {
                        cpu_state = CpuState::idle;
                    }
                    default: {
                        cpu_state = CpuState::idle;
                    }
                }
            }
        }
        always_ff (i_mem_clk, mem_reset) {
            if_reset {
                mem_state        = MemState::idle;
                response_toggle  = 0;
                request_sync     = 0;
                response_mailbox = 0;
                mem_address      = 0;
                mem_write        = 0;
                mem_strobe       = 0;
            } else {
                request_sync = {request_sync[0], request_toggle};
                case mem_state {
                    MemState::idle   : if request_sync[1] != response_toggle {
                        mem_address = address_mailbox;
                        mem_write   = write_mailbox;
                        mem_strobe  = strobe_mailbox;
                        mem_state   = MemState::request;
                    }
                    MemState::request: if i_req_ready {
                        if i_rsp_valid {
                            response_mailbox = i_rsp_data;
                            response_toggle  = request_sync[1];
                            mem_state        = MemState::idle;
                        } else {
                            mem_state = MemState::waiting;
                        }
                    }
                    MemState::waiting: if i_rsp_valid {
                        response_mailbox = i_rsp_data;
                        response_toggle  = request_sync[1];
                        mem_state        = MemState::idle;
                    }
                    default          : {
                        mem_state = MemState::idle;
                    }
                }
            }
        }
    }
    assign o_ready     = cpu_state == CpuState::response;
    assign o_req_valid = mem_state == MemState::request;
    assign o_req_addr  = {mem_address[31:4], 4'b0};
    always_comb {
        o_req_wdata                            = 0;
        o_req_wstrb                            = 0;
        o_req_wdata[32 * mem_address[3:2]+:32] = mem_write;
        o_req_wstrb[4 * mem_address[3:2]+:4]   = mem_strobe;
    }
}
