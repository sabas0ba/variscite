/// 256-byte CPU register window for a polled FS/LS USB host.
/// One command mailbox crosses to CLKOUT; buffers are immutable while busy.
/// SOF/keepalive runs independently of CPU scheduling. See docs/tang-usb-host.md.
module UsbHostMmio #(
    param TRACE: u32 = 0,
) (
    i_cpu_clk: input  'cpu   clock               ,
    i_usb_clk: input  'usb   clock               ,
    i_reset  : input  'async reset_async_high    ,
    i_sel    : input  'cpu   logic               ,
    i_addr   : input  'cpu   logic           <8> ,
    i_wdata  : input  'cpu   logic           <32>,
    i_wstrb  : input  'cpu   logic           <4> ,
    o_rdata  : output 'cpu   logic           <32>,
    i_dir    : input  'usb   logic               ,
    i_nxt    : input  'usb   logic               ,
    i_data   : input  'usb   logic           <8> ,
    o_data   : output 'usb   logic           <8> ,
    o_drive  : output 'usb   logic               ,
    o_stp    : output 'usb   logic               ,
) {
    enum State: logic<4> {
        idle,
        speed_start,
        speed_wait,
        transfer_start,
        transfer_wait,
        restore_start,
        restore_wait,
        complete,
    }
    var state          : 'usb State         ;
    var control        : 'cpu logic<2>      ;
    var command        : 'cpu logic<32>     ;
    var phy_request    : 'cpu logic<16>     ;
    var tx_buffer      : 'cpu logic<32> [16];
    var rx_buffer      : 'usb logic<8>  [64];
    var request_toggle : 'cpu logic         ;
    var response_toggle: 'usb logic         ;
    var result_mailbox : 'usb logic<32>     ;
    #[sv("async_reg = \"true\"")]
    var request_sync: 'usb logic<2>;
    #[sv("async_reg = \"true\"")]
    var response_sync: 'cpu logic<2>;
    #[sv("async_reg = \"true\"")]
    var control_meta: 'usb logic<2>;
    #[sv("async_reg = \"true\"")]
    var control_sync: 'usb logic<2>;
    #[sv("async_reg = \"true\"")]
    var usb_release: 'usb logic<2> ;
    var usb_reset  : 'usb reset    ;
    var busy       : 'cpu logic    ;
    var completed  : 'cpu logic    ;
    var cpu_result : 'cpu logic<32>;
    var cpu_busy_d : 'cpu logic    ;
    var frame_timer: 'usb logic<16>;
    var frame      : 'usb logic<11>;
    var frame_gray : 'usb logic<11>;
    #[sv("async_reg = \"true\"")]
    var frame_meta: 'cpu logic<11>;
    #[sv("async_reg = \"true\"")]
    var frame_sync  : 'cpu logic<11>;
    var frame_binary: 'cpu logic<11>;
    var sof_due     : 'usb logic    ;
    var sof_missed  : 'usb logic    ;
    #[sv("async_reg = \"true\"")]
    var missed_sync     : 'cpu logic<2> ;
    var automatic_sof   : 'usb logic    ;
    var active_command  : 'usb logic<32>;
    var active_phy      : 'usb logic<16>;
    var current_speed   : 'usb logic<2> ;
    var desired_speed   : 'usb logic<2> ;
    var engine_valid    : 'usb logic    ;
    var engine_ready    : 'usb logic    ;
    var engine_done     : 'usb logic    ;
    var engine_result   : 'usb logic<4> ;
    var engine_length   : 'usb logic<7> ;
    var engine_toggle   : 'usb logic    ;
    var engine_phy      : 'usb logic<8> ;
    var tx_index        : 'usb logic<6> ;
    var rx_index        : 'usb logic<6> ;
    var rx_write        : 'usb logic    ;
    var rx_byte         : 'usb logic<8> ;
    var line_state      : 'usb logic<2> ;
    var engine_operation: 'usb logic<3> ;
    var engine_address  : 'usb logic<6> ;
    var engine_value    : 'usb logic<8> ;
    // Frozen PHY-command samples for board diagnostics; read only when idle.
    var phy_trace     : 'usb logic<32> [16];
    var trace_count   : 'usb logic<5>      ;
    var trace_active  : 'usb logic         ;
    let root_speed    : 'usb logic<2>       = if control_sync[1] ? 2'd2 : 2'd1;
    let changing_speed: 'usb logic          = state == State::speed_start || state == State::restore_start;
    assign busy             = request_toggle != response_sync[1];
    assign usb_reset        = (!usb_release[1]) as reset;
    assign engine_valid     = state == State::speed_start || state == State::transfer_start || state
        == State::restore_start;
    assign engine_operation = if changing_speed ? 3'd5 : active_command[2:0];
    assign engine_address   = if changing_speed ? 6'h04 : active_phy[5:0];
    assign engine_value     = if changing_speed ? {6'b010001, desired_speed} : active_phy[15:8];
    always_comb {
        for n in 0..11 {
            frame_binary[n] = ^(frame_sync >> n);
        }
    }
    unsafe (cdc) {
        always_comb {
            o_rdata = 0;
            case i_addr[7:2] {
                6'h00  : o_rdata = 32'h55484231;
                6'h01  : o_rdata = {30'b0, control};
                6'h02  : o_rdata = cpu_result | {30'b0, completed, busy};
                6'h03  : o_rdata = command;
                6'h04  : o_rdata = {16'b0, phy_request};
                6'h05  : o_rdata = {20'b0, missed_sync[1], frame_binary};
                6'h06  : o_rdata = if !busy ? {27'b0, trace_count} : 32'd0;
                default: {
                    if TRACE != 0 && i_addr[7:6] == 2'b11 && !busy {
                        o_rdata = phy_trace[i_addr[5:2]];
                    }
                    if i_addr[7:6] == 2'b01 {
                        o_rdata = tx_buffer[i_addr[5:2]];
                    }
                    if i_addr[7:6] == 2'b10 && !busy {
                        o_rdata = {
                            rx_buffer[{i_addr[5:2], 2'b11}], rx_buffer[{i_addr[5:2], 2'b10}],
                            rx_buffer[{i_addr[5:2], 2'b01}], rx_buffer[{i_addr[5:2], 2'b00}]
                        };
                    }
                }
            }
        }
        always_ff (i_cpu_clk) {
            if i_sel && !busy && i_addr[7:6] == 2'b01 {
                for lane in 0..4 {
                    if i_wstrb[lane] {
                        tx_buffer[i_addr[5:2]][lane * 8+:8] = i_wdata[lane * 8+:8];
                    }
                }
            }
        }
        always_ff (i_cpu_clk, i_reset) {
            if_reset {
                control        = 0;
                command        = 0;
                phy_request    = 0;
                request_toggle = 0;
                response_sync  = 0;
                completed      = 0;
                cpu_result     = 0;
                cpu_busy_d     = 0;
                frame_meta     = 0;
                frame_sync     = 0;
                missed_sync    = 0;
            } else {
                response_sync = {response_sync[0], response_toggle};
                frame_meta    = frame_gray;
                frame_sync    = frame_meta;
                missed_sync   = {missed_sync[0], sof_missed};
                cpu_busy_d    = busy;
                if cpu_busy_d && !busy {
                    completed  = 1;
                    cpu_result = result_mailbox;
                }
                if i_sel && i_wstrb == 4'hf && !busy {
                    case i_addr {
                        8'h04: control = i_wdata[1:0];
                        8'h0c: {
                            if i_wdata[31] {
                                command        = i_wdata;
                                request_toggle = !request_toggle;
                                completed      = 0;
                                cpu_result     = 0;
                            }
                        }
                        8'h10  : phy_request = i_wdata[15:0];
                        default: {}
                    }
                }
            }
        }
        always_ff (i_usb_clk, i_reset) {
            if_reset {
                usb_release  = 0;
                request_sync = 0;
                control_meta = 0;
                control_sync = 0;
            } else {
                usb_release  = {usb_release[0], 1'b1};
                request_sync = {request_sync[0], request_toggle};
                control_meta = control;
                control_sync = control_meta;
            }
        }
        inst transaction: UsbHostTransaction (
            i_clk        : i_usb_clk                                     ,
            i_rst        : usb_reset                                     ,
            i_valid      : engine_valid                                  ,
            o_ready      : engine_ready                                  ,
            i_operation  : engine_operation                              ,
            i_token      : active_command[26:16]                         ,
            i_toggle     : active_command[3]                             ,
            i_low_speed  : desired_speed[1]                              ,
            i_length     : active_command[14:8]                          ,
            i_phy_address: engine_address                                ,
            i_phy_value  : engine_value                                  ,
            o_tx_index   : tx_index                                      ,
            i_tx_byte    : tx_buffer[tx_index[5:2]][tx_index[1:0] * 8+:8],
            o_rx_write   : rx_write                                      ,
            o_rx_index   : rx_index                                      ,
            o_rx_byte    : rx_byte                                       ,
            o_done       : engine_done                                   ,
            o_result     : engine_result                                 ,
            o_length     : engine_length                                 ,
            o_toggle     : engine_toggle                                 ,
            o_phy_value  : engine_phy                                    ,
            i_dir                                                        ,
            i_nxt                                                        ,
            i_data                                                       ,
            o_data                                                       ,
            o_drive                                                      ,
            o_stp                                                        ,
            o_line       : line_state                                    ,
        );
        always_ff (i_usb_clk) {
            if rx_write {
                rx_buffer[rx_index] = rx_byte;
            }
        }
        always_ff (i_usb_clk, usb_reset) {
            if_reset {
                trace_count  = 0;
                trace_active = 0;
            } else if TRACE != 0 && engine_valid && engine_ready && engine_operation >= 4 && !automatic_sof {
                trace_count  = 0;
                trace_active = 1;
            } else if trace_active {
                trace_count = trace_count + 1;
                if engine_done || trace_count == 15 {
                    trace_active = 0;
                }
            }
        }
        // Validity is tracked by trace_count; storage does not need reset.
        always_ff (i_usb_clk) {
            if trace_active {
                phy_trace[trace_count[3:0]] = {engine_phy, 4'b0, o_drive, o_stp, i_nxt, i_dir, o_data, i_data};
            }
        }
        always_ff (i_usb_clk, usb_reset) {
            if_reset {
                state           = State::idle;
                response_toggle = 0;
                result_mailbox  = 0;
                frame_timer     = 0;
                frame           = 0;
                frame_gray      = 0;
                sof_due         = 0;
                sof_missed      = 0;
                automatic_sof   = 0;
                active_command  = 0;
                active_phy      = 0;
                current_speed   = 0;
                desired_speed   = 0;
            } else {
                if !control_sync[0] {
                    frame_timer = 0;
                    sof_due     = 0;
                } else if frame_timer == 16'd59999 {
                    frame_timer = 0;
                    frame       = frame + 1;
                    frame_gray  = ((frame + 11'd1) >> 1) ^ (frame + 11'd1);
                    if sof_due {
                        sof_missed = 1;
                    }
                    sof_due = 1;
                } else {
                    frame_timer = frame_timer + 1;
                }
                case state {
                    State::idle: {
                        if control_sync[0] && sof_due {
                            automatic_sof  = 1;
                            sof_due        = 0;
                            active_command = {5'b0, frame, 13'b0, 3'd3};
                            desired_speed  = root_speed;
                            state          = if current_speed == root_speed ?
                                State::transfer_start
                            :
                                State::speed_start
                            ;
                        } else if request_sync[1] != response_toggle && (!control_sync[0] || frame_timer <: 16'd42000) {
                            automatic_sof  = 0;
                            active_command = command;
                            active_phy     = phy_request;
                            desired_speed  = command[5:4];
                            state          = if command[2:0] >= 4 || current_speed == command[5:4] ?
                                State::transfer_start
                            :
                                State::speed_start
                            ;
                            if command[2:0] <: 4 && (command[5:4] == 0 || (command[5] && command[14:8] >: 8)) {
                                result_mailbox = 32'h70;
                                state          = State::complete;
                            }
                        }
                    }
                    State::speed_start: {
                        if engine_ready {
                            state = State::speed_wait;
                        }
                    }
                    State::speed_wait: {
                        if engine_done {
                            if engine_result == 1 {
                                current_speed = desired_speed;
                                state         = State::transfer_start;
                            } else {
                                result_mailbox = 32'h80;
                                state          = State::complete;
                            }
                        }
                    }
                    State::transfer_start: {
                        if engine_ready {
                            state = State::transfer_wait;
                        }
                    }
                    State::transfer_wait: {
                        if engine_done {
                            if !automatic_sof {
                                result_mailbox = {
                                    6'b0, line_state, engine_phy, engine_toggle, engine_length, engine_result, 4'b0
                                };
                            }
                            if active_command[2:0] >= 4 {
                                current_speed = 0;
                                state         = State::complete;
                            } else if control_sync[0] && current_speed != root_speed {
                                desired_speed = root_speed;
                                state         = State::restore_start;
                            } else {
                                state = State::complete;
                            }
                        }
                    }
                    State::restore_start: {
                        if engine_ready {
                            state = State::restore_wait;
                        }
                    }
                    State::restore_wait: {
                        if engine_done {
                            current_speed = if engine_result == 1 ? desired_speed : 2'd0;
                            if engine_result != 1 {
                                result_mailbox = 32'h80;
                            }
                            state = State::complete;
                        }
                    }
                    State::complete: {
                        if !automatic_sof {
                            response_toggle = request_sync[1];
                        }
                        state = State::idle;
                    }
                    default: state = State::idle;
                }
            }
        }
    }
}
