/// CPU and LCD integration with explicit clocks for hardware and simulation.
module TangLcdSystem #(
    param CLK_HZ  : u32 = 27_000_000,
    param UART_DIV: u32 = 15        ,
) (
    i_clk      : input  'cpu   clock    ,
    i_rst      : input  'cpu   reset    ,
    i_pixel_clk: input  'pixel clock    ,
    i_pixel_rst: input  'pixel reset    ,
    i_lcd_ready: input  'cpu   logic    ,
    i_uart_rx  : input  'cpu   logic    ,
    o_uart_tx  : output 'cpu   logic    ,
    o_retire   : output 'cpu   logic    ,
    lcd_hs     : output 'pixel logic    ,
    lcd_vs     : output 'pixel logic    ,
    lcd_de     : output 'pixel logic    ,
    lcd_rgb    : output 'pixel logic<16>,
) {
    var ext_sel         : 'cpu   logic     ;
    var ext_addr        : 'cpu   logic<32> ;
    var ext_wdata       : 'cpu   logic<32> ;
    var ext_rdata       : 'cpu   logic<32> ;
    var ext_wstrb       : 'cpu   logic<4>  ;
    var frame_start     : 'pixel logic     ;
    var config_data     : 'pixel logic<224>;
    let peripheral_reset: 'cpu   reset      = (i_rst || !i_lcd_ready) as reset;
    inst soc: FpgaSoc #(
        CLK_HZ     : CLK_HZ                 ,
        UART_DIV   : UART_DIV               ,
        RAM_WORDS  : 8192                   ,
        PMP_ENTRIES: 4                      ,
        RAM_INIT   : "sim/fpga/firmware.hex",
    ) (
        i_clk                 ,
        i_rst                 ,
        i_uart_rx             ,
        o_uart_tx             ,
        o_retire              ,
        o_ext_sel  : ext_sel  ,
        o_ext_addr : ext_addr ,
        o_ext_wstrb: ext_wstrb,
        o_ext_wdata: ext_wdata,
        i_ext_rdata: ext_rdata,
    );
    inst regs: TangLcdMmio (
        i_cpu_clk  : i_clk           ,
        i_cpu_rst  : peripheral_reset,
        i_sel      : ext_sel         ,
        i_addr     : ext_addr        ,
        i_wstrb    : ext_wstrb       ,
        i_wdata    : ext_wdata       ,
        o_rdata    : ext_rdata       ,
        i_pixel_clk                  ,
        i_pixel_rst                  ,
        i_frame    : frame_start     ,
        o_config   : config_data     ,
    );
    inst timing: TangLcdTiming (
        i_clk  : i_pixel_clk         ,
        i_rst  : i_pixel_rst         ,
        i_bars : config_data[0]      ,
        i_bg   : config_data[47:32]  ,
        i_fg   : config_data[79:64]  ,
        i_x0   : config_data[105:96] ,
        i_y0   : config_data[136:128],
        i_x1   : config_data[169:160],
        i_y1   : config_data[200:192],
        o_frame: frame_start         ,
        o_hs   : lcd_hs              ,
        o_vs   : lcd_vs              ,
        o_de   : lcd_de              ,
        o_rgb  : lcd_rgb             ,
    );
}
