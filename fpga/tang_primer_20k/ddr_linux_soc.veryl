/// Linux platform behind the trained DDR PHY: ROM, UART, CLINT/PLIC and DDR.
/// Both clocks and the memory backend share reset; enable follows PHY training.
module DdrLinuxSoc #(
    param ROM_INIT : string = "sim/tang_boot.hex",
    param ROM_WORDS: u32    = 1024               ,
    param CLK_HZ   : u32    = 27_000_000         ,
    param UART_DIV : u32    = 15                 ,
    param WITH_LCD : u32    = 0                  ,
    param WITH_IO  : u32    = 0                  ,
) (
    i_cpu_clk       : input  'cpu   clock                    ,
    i_mem_clk       : input  'mem   clock                    ,
    i_reset         : input  'async reset_async_high         ,
    i_enable        : input  'mem   logic                    ,
    i_uart_rx       : input  'cpu   logic                    ,
    o_uart_tx       : output 'cpu   logic                    ,
    o_shutdown      : output 'cpu   logic                    ,
    o_exit_code     : output 'cpu   logic           <32>     ,
    o_display_enable: output 'cpu   logic                    ,
    i_display_error : input  'cpu   logic           <2>      ,
    i_io_rdata      : input  'cpu   logic           <32>  = 0,
    o_io_sel        : output 'cpu   logic                 = _,
    o_io_addr       : output 'cpu   logic           <32>  = _,
    o_io_wdata      : output 'cpu   logic           <32>  = _,
    o_io_wstrb      : output 'cpu   logic           <4>   = _,
    o_req_valid     : output 'mem   logic                    ,
    i_req_ready     : input  'mem   logic                    ,
    o_req_addr      : output 'mem   logic           <27>     ,
    o_req_wdata     : output 'mem   logic           <128>    ,
    o_req_wstrb     : output 'mem   logic           <16>     ,
    i_rsp_valid     : input  'mem   logic                    ,
    o_rsp_ready     : output 'mem   logic                    ,
    i_rsp_data      : input  'mem   logic           <128>    ,
    i_rsp_error     : input  'mem   logic                    ,
) {
    #[sv("async_reg = \"true\"")]
    var enable_sync: 'cpu logic<2>;
    var cpu_reset  : 'cpu reset   ;
    unsafe (cdc) {
        always_ff (i_cpu_clk, i_reset) {
            if_reset {
                enable_sync = 0;
            } else {
                enable_sync = {enable_sync[0], i_enable};
            }
        }
        assign cpu_reset = (i_reset || !enable_sync[1]) as reset;
    }
    const TICK_DIV  : u32           = (CLK_HZ + 500_000) / 1_000_000;
    const TICK_W    : u32           = if TICK_DIV <= 1 ? 1 : $clog2(TICK_DIV);
    var   tick_count: 'cpu logic<TICK_W>;
    let   tick      : 'cpu logic         = tick_count == (TICK_DIV - 1) as TICK_W;
    always_ff (i_cpu_clk, cpu_reset) {
        if_reset {
            tick_count = 0;
        } else if tick {
            tick_count = 0;
        } else {
            tick_count = tick_count + 1;
        }
    }
    var valid      : 'cpu logic    ;
    var addr       : 'cpu logic<32>;
    var wdata      : 'cpu logic<32>;
    var wstrb      : 'cpu logic<4> ;
    var rom_data   : 'cpu logic<32>;
    var uart_data  : 'cpu logic<32>;
    var uart_irq   : 'cpu logic    ;
    var held_data  : 'cpu logic<32>;
    var local_ready: 'cpu logic    ;
    var ddr_ready  : 'cpu logic    ;
    var ddr_error  : 'cpu logic    ;
    var ddr_data   : 'cpu logic<32>;
    var core_valid : 'cpu logic    ;
    var core_addr  : 'cpu logic<32>;
    var core_wdata : 'cpu logic<32>;
    var core_wstrb : 'cpu logic<4> ;
    var core_ready : 'cpu logic    ;
    var core_rdata : 'cpu logic<32>;
    var core_error : 'cpu logic    ;
    let rom_hit    : 'cpu logic     = addr >= 32'h00001000 && addr <: 32'h00001000 + ROM_WORDS * 4;
    let uart_hit   : 'cpu logic     = addr[31:5] == 27'h0800000;
    let syscon_hit : 'cpu logic     = addr == 32'h11100000;
    let display_hit: 'cpu logic     = WITH_LCD != 0 && addr == 32'h11200000;
    let io_hit     : 'cpu logic     = WITH_IO != 0 && (addr[31:8] == 24'h113000 || addr[31:8] == 24'h114000);
    let local_hit  : 'cpu logic     = rom_hit || uart_hit || syscon_hit || display_hit || io_hit;
    let local_start: 'cpu logic     = valid && local_hit && !local_ready;
    let ready      : 'cpu logic     = if local_hit ? local_ready : ddr_ready;
    let error      : 'cpu logic     = if local_hit ? rom_hit && wstrb != 0 : ddr_error;
    let rdata      : 'cpu logic<32> = if rom_hit ? rom_data : if local_hit ? held_data : ddr_data;
    assign o_io_sel   = local_start && io_hit;
    assign o_io_addr  = addr;
    assign o_io_wdata = wdata;
    assign o_io_wstrb = wstrb;
    if WITH_IO != 0 :io_pipeline {
        enum BusState: logic<2> {
            idle,
            request,
            response,
        }
        var bus_state: 'cpu BusState;
        assign valid      = bus_state == BusState::request;
        assign core_ready = bus_state == BusState::response;
        // Cut the CPU protection/decode path before the larger peripheral mux.
        // The request and response each remain stable for their handshake.
        always_ff (i_cpu_clk, cpu_reset) {
            if_reset {
                bus_state  = BusState::idle;
                addr       = 0;
                wdata      = 0;
                wstrb      = 0;
                core_rdata = 0;
                core_error = 0;
            } else {
                case bus_state {
                    BusState::idle: {
                        if core_valid {
                            addr      = core_addr;
                            wdata     = core_wdata;
                            wstrb     = core_wstrb;
                            bus_state = BusState::request;
                        }
                    }
                    BusState::request: {
                        if ready {
                            core_rdata = rdata;
                            core_error = error;
                            bus_state  = BusState::response;
                        }
                    }
                    BusState::response: bus_state = BusState::idle;
                    default           : bus_state = BusState::idle;
                }
            }
        }
    } else :direct_bus {
        assign valid      = core_valid;
        assign addr       = core_addr;
        assign wdata      = core_wdata;
        assign wstrb      = core_wstrb;
        assign core_ready = ready;
        assign core_rdata = rdata;
        assign core_error = error;
    }
    always_ff (i_cpu_clk, cpu_reset) {
        if_reset {
            local_ready      = 0;
            held_data        = 0;
            o_shutdown       = 0;
            o_exit_code      = 0;
            o_display_enable = 0;
        } else {
            local_ready = local_start;
            if local_start {
                held_data = if uart_hit ?
                    uart_data
                : if io_hit ?
                    i_io_rdata
                : if display_hit ?
                    {29'b0, i_display_error, o_display_enable}
                :
                    o_exit_code
                ;
                // Enable is sticky until common reset; software initializes the
                // complete framebuffer before setting bit 0. Other bits are RO.
                if display_hit && wstrb[0] && wdata[0] {
                    o_display_enable = 1;
                }
                if syscon_hit && wstrb == 4'hf && !o_shutdown {
                    o_exit_code = wdata;
                    o_shutdown  = 1;
                }
            }
        }
    }
    inst rom: Ram #(
        WORDS: ROM_WORDS,
        INIT : ROM_INIT ,
    ) (
        i_clk  : i_cpu_clk             ,
        i_en   : local_start && rom_hit,
        i_addr : addr - 32'h1000,
        i_wstrb: 4'b0                  ,
        i_wdata: 32'b0                 ,
        o_rdata: rom_data              ,
    );
    inst uart: Uart #(
        RESET_DIV: UART_DIV,
    ) (
        i_clk  : i_cpu_clk              ,
        i_rst  : cpu_reset              ,
        i_sel  : local_start && uart_hit,
        i_addr : addr[4:2]              ,
        i_wstrb: wstrb                  ,
        i_wdata: wdata                  ,
        o_rdata: uart_data              ,
        i_rx   : i_uart_rx              ,
        o_tx   : o_uart_tx              ,
        o_irq  : uart_irq               ,
    );
    inst soc: Soc #(
        PMP_ENTRIES: 4,
    ) (
        i_clk         : i_cpu_clk ,
        i_rst         : cpu_reset ,
        o_mem_valid   : core_valid,
        o_mem_addr    : core_addr ,
        o_mem_wstrb   : core_wstrb,
        o_mem_wdata   : core_wdata,
        i_mem_rdata   : core_rdata,
        i_mem_ready   : core_ready,
        i_mem_error   : core_error,
        i_mtime_tick  : tick      ,
        i_irq_src     : uart_irq  ,
        o_retire      : _         ,
        o_retire_pc   : _         ,
        o_retire_instr: _         ,
        o_trap        : _         ,
        o_trap_cause  : _         ,
    );
    inst word_port: DdrWordPort (
        i_cpu_clk                                         ,
        i_mem_clk                                         ,
        i_reset                                           ,
        i_valid    : valid && !local_hit && enable_sync[1],
        i_addr     : addr                                 ,
        i_wdata    : wdata                                ,
        i_wstrb    : wstrb                                ,
        o_ready    : ddr_ready                            ,
        o_rdata    : ddr_data                             ,
        o_error    : ddr_error                            ,
        o_req_valid                                       ,
        i_req_ready                                       ,
        o_req_addr                                        ,
        o_req_wdata                                       ,
        o_req_wstrb                                       ,
        i_rsp_valid                                       ,
        o_rsp_ready                                       ,
        i_rsp_data                                        ,
        i_rsp_error                                       ,
    );
}
