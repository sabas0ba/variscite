/// Train DDR, then run the UART boot ROM and the uploaded Linux image.
module TangLinuxLcdTop (
    i_uart_rx  : input  'reference logic        ,
    i_clk      : input  'reference clock        ,
    o_uart_tx  : output 'reference logic        ,
    lcd_dclk   : output 'pixel     clock        ,
    lcd_hs     : output 'pixel     logic        ,
    lcd_vs     : output 'pixel     logic        ,
    lcd_de     : output 'pixel     logic        ,
    lcd_r      : output 'pixel     logic    <5> ,
    lcd_g      : output 'pixel     logic    <6> ,
    lcd_b      : output 'pixel     logic    <5> ,
    ddr_dq     : inout  'async     tri logic<16>,
    ddr_dqs_p  : inout  'async     tri logic<2> ,
    ddr_dqs_n  : inout  'async     tri logic<2> ,
    ddr_dm     : output 'fast      logic    <2> ,
    ddr_addr   : output 'fast      logic    <14>,
    ddr_bank   : output 'fast      logic    <3> ,
    ddr_ras_n  : output 'fast      logic        ,
    ddr_cas_n  : output 'fast      logic        ,
    ddr_we_n   : output 'fast      logic        ,
    ddr_cs_n   : output 'fast      logic        ,
    ddr_cke    : output 'fast      logic        ,
    ddr_odt    : output 'fast      logic        ,
    ddr_reset_n: output 'ctrl      logic        ,
    ddr_clk_p  : output 'fast      logic        ,
    ddr_clk_n  : output 'fast      logic        ,
) {
    inst probe: TangDdrInitProbe #(
        CPU_ROM_INIT   : "sim/tang_boot_lcd.hex",
        READ_TAPS      : 5'd6                   ,
        READ_DECREASE  : 1                      ,
        WITH_LCD       : 1                      ,
        RUN_CONTROLLER : 5                      ,
        ARRAY_TRAIN    : 1                      ,
        RUN_ARRAY      : 1                      ,
        ARRAY_ASSEMBLE : 1                      ,
        ARRAY_TIMELINE : 0                      ,
        ARRAY_READ_HOLD: 0                      ,
        DLL_QUARTER    : 0                      ,
        ARRAY_READ_SEL : 6'h24                  ,
        PHY_STARTUP    : 1                      ,
    ) (
        i_clk                             ,
        i_uart_rx                         ,
        lcd_dclk                          ,
        lcd_hs                            ,
        lcd_vs                            ,
        lcd_de                            ,
        lcd_rgb    : {lcd_r, lcd_g, lcd_b},
        o_uart_tx                         ,
        ddr_dq                            ,
        ddr_dqs_p                         ,
        ddr_dqs_n                         ,
        ddr_dm                            ,
        ddr_addr                          ,
        ddr_bank                          ,
        ddr_ras_n                         ,
        ddr_cas_n                         ,
        ddr_we_n                          ,
        ddr_cs_n                          ,
        ddr_cke                           ,
        ddr_odt                           ,
        ddr_reset_n                       ,
        ddr_clk_p                         ,
        ddr_clk_n                         ,
    );
}
