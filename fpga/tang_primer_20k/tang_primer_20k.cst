// Sipeed Tang Primer 20K, core board pins only (see fpga/tang_primer_20k/top.veryl).
//
// H11 is the 27 MHz crystal. T13/M11 are the serial pair that reaches the
// USB-serial bridge through the ext-board connector; M11 is driven by the FPGA.

IO_LOC  "i_clk" H11;
IO_PORT "i_clk" IO_TYPE=LVCMOS33;

IO_LOC  "i_uart_rx" T13;
IO_PORT "i_uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "o_uart_tx" M11;
IO_PORT "o_uart_tx" IO_TYPE=LVCMOS33 DRIVE=8;
