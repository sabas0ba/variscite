/// Sequence PHY clocks in the reference domain, which continues while DDR clocks stop.
/// Lock inputs must already be synchronized to i_clk. TICKS must be positive.
module DdrPhyStartup #(
    param TICKS: u32 = 8,
) (
    i_clk       : input  clock,
    i_rst       : input  reset,
    i_pll_locked: input  logic,
    i_dll_locked: input  logic,
    o_freeze    : output logic,
    o_stop      : output logic,
    o_div_reset : output logic,
    o_phy_reset : output logic,
    o_hold      : output logic,
    o_update_n  : output logic,
    o_ready     : output logic,
) {
    // 0 wait, 1 freeze, 2 stop, 3 reset divider, 4 release reset,
    // 5 run clocks, 6 release DLL, 7 hold DQS, 8 update code, 9 recover, 10 ready.
    var phase     : logic<4> ;
    var elapsed   : logic<32>;
    var next_phase: logic<4> ;
    var ready     : logic    ;
    always_comb {
        next_phase = phase;
        if !i_pll_locked || (phase == 10 && !i_dll_locked) {
            next_phase = 0;
        } else if phase == 0 {
            if i_dll_locked && elapsed + 1 >= TICKS {
                next_phase = 1;
            }
        } else if phase <: 10 && elapsed + 1 >= TICKS {
            next_phase = phase + 4'd1;
        }
    }
    always_ff {
        if_reset {
            phase       = 0;
            elapsed     = 0;
            o_freeze    = 0;
            o_stop      = 0;
            o_div_reset = 0;
            o_phy_reset = 1;
            o_hold      = 0;
            o_update_n  = 1;
            ready       = 0;
        } else {
            phase   = next_phase;
            elapsed = if next_phase != phase || !i_pll_locked || (phase == 0 && !i_dll_locked) || phase == 10 ?
                0
            :
                elapsed + 1
            ;
            // Register every asynchronous control to avoid combinational decode glitches.
            o_freeze    = next_phase >= 1 && next_phase <= 5;
            o_stop      = next_phase >= 2 && next_phase <= 4;
            o_div_reset = next_phase == 3;
            o_phy_reset = next_phase <: 4;
            o_hold      = next_phase >= 7 && next_phase <= 9;
            o_update_n  = next_phase != 8;
            ready       = next_phase == 10;
        }
    }
    assign o_ready = ready && i_pll_locked && i_dll_locked;
}
